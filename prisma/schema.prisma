generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cafe {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  logoUrl     String?
  coverUrl    String?
  primaryColor String  @default("#6F4E37")
  accentColor  String  @default("#D4A96A")
  fontFamily   String  @default("serif")

  // Social/Link buttons
  menuUrl      String?
  mapsUrl      String?
  instagramUrl String?
  whatsappUrl  String?
  websiteUrl   String?
  customLinks  String? // JSON array of {label, url, icon}
  reviewUrl    String? // link de reseña de Google Maps (para pedir reseñas a los clientes)

  // Loyalty config
  loyaltyEnabled    Boolean @default(true)
  stampEnabled      Boolean @default(true)
  stampsRequired    Int     @default(10)
  stampReward       String  @default("1 free coffee")
  pointsEnabled     Boolean @default(true)
  pointsPerPeso     Float   @default(1.0)   // points per currency unit
  currencySymbol    String  @default("$")
  minPurchaseForStamp Float @default(0)     // 0 = no minimum
  stampExpiryDays   Int     @default(0)     // días hasta que vencen los sellos activos; 0 = no vencen

  // ── Plan / suscripción ────────────────────────────────
  // Nuevos cafés (alta self-service) arrancan en "trial" con tope de clientes.
  // Los cafés existentes se marcan isPermanent=true en el backfill (grandfathered).
  // ── Referidos ─────────────────────────────────────────
  // El referente cobra recién en la 1ª compra real del referido (anti-abuso).
  referralEnabled      Boolean @default(false)
  referralRewardType   String  @default("points") // "points" | "stamps"
  referralRewardAmount Float   @default(50)

  planStatus    String    @default("trial")  // "trial" | "active" | "expired"
  isPermanent   Boolean   @default(false)     // activado para siempre por superadmin / grandfathered
  activeUntil   DateTime?                      // vencimiento cuando planStatus="active"
  planTier      String    @default("free")     // "free" | "economico" | "medio" | "grande" | "grandfathered" — ver lib/plans.ts
  customerLimit Int       @default(10)         // tope de clientes del tier actual (ignorado si planTier="grandfathered")
  activatedAt   DateTime?                      // última activación por superadmin

  // Aviso proactivo de capacidad (no depende de Mercado Pago, ver sipo-plan/04-mercado-pago/plan.md §5I).
  // null = no avisado / se re-arma solo al volver a caer por debajo del umbral. Barrido por el cron
  // diario contra TODOS los cafés, no enganchado en el alta de cliente (un día de latencia es aceptable).
  capacityWarningSentAt DateTime?

  // ── Mercado Pago (cobro automático de la suscripción, ver sipo-plan/04-mercado-pago/plan.md) ──
  // Fase 1: alta + activar tier al primer cobro. mpPreapprovalStatus es solo diagnóstico (espejo de
  // MP); la lógica de negocio real sigue viviendo en planTier/activeUntil, igual que siempre.
  mpPreapprovalId         String?   // id de la suscripción en MP
  // Email de la cuenta de MERCADO PAGO del dueño. MP exige payer_email al crear la suscripción y
  // valida que quien autoriza entre con esa misma cuenta: si el dueño usa un mail distinto en MP
  // que en Sipo, tira "tu email no coincide con el de la suscripción". Por eso se pregunta y se
  // guarda aparte del Owner.email de login. null = todavía no lo cargó (se usa el de login).
  mpPayerEmail            String?
  mpPreapprovalStatus     String?   // espejo del status de MP: "pending" | "authorized" | "cancelled"
  pendingSubscriptionTier String?   // tier elegido al hacer alta, pendiente de que el PRIMER cobro
                                     // confirme (nunca se sube el tier antes de esa confirmación —
                                     // ver plan §5A, cuidado con el back_url optimista)
  pendingSubscriptionAt   DateTime? // cuándo arrancó ese intento — si nunca se confirma, el cron
                                     // lo limpia solo pasadas PENDING_SUBSCRIPTION_TIMEOUT_HOURS
                                     // (si no, el panel queda trabado en "Confirmando…" para siempre)
  mpLastChargeAt          DateTime?
  mpLastChargeStatus      String?   // "approved" | "rejected" (último intento de cobro conocido)
  mpLastProcessedPaymentId String?  // id del último pago de MP ya aplicado — evita reprocesar el
                                     // mismo webhook reenviado (idempotencia, ver plan §6)
  // Fase 2: throttle del mail "no pudimos cobrarte" — lo setea el CRON al mandarlo (no el
  // webhook), así el webhook no necesita saber nada de mails (ver lib/subscriptionWebhook.ts).
  // null = no avisado todavía para el fallo actual; se limpia solo con el próximo cobro aprobado.
  mpFirstFailureAt        DateTime?
  // Fase 3: pedido del dueño de cambiar de tier (subir o bajar). No se ejecuta solo — queda
  // pendiente para que el superadmin lo aplique a mano (ver plan §5F).
  planChangeRequestedTier String?
  planChangeRequestedAt   DateTime?
  planChangeNotifiedAt    DateTime? // ya se le avisó al equipo por mail de este pedido

  // Fase 4: sincronización del precio cobrado en MP contra el precio vigente del tier.
  // mpSubscriptionAmount = lo que MP le cobra HOY (lo seteamos nosotros al crear/actualizar).
  // Si el precio del tier cambia en lib/plans.ts, el cron detecta la diferencia solo, avisa al
  // dueño, y recién PRICE_CHANGE_NOTICE_DAYS después aplica el monto nuevo (ver plan §5G).
  mpSubscriptionAmount    Int?
  pendingBillingSyncAt    DateTime?

  // Día del mes en el que arrancó el período pago (28/29/30/31 incluidos). Sumar meses recortando
  // contra este día evita que un café que arrancó un 31 quede venciendo los 3 de cada mes: sin
  // ancla, "31 de enero + 1 mes" desborda al 3 de marzo y la fecha nunca vuelve a subir.
  // Ver lib/dates.ts. null = todavía no se fijó; se recorta contra el día de la fecha base, que es
  // exactamente lo que ya venía pasando (ningún café existente cambia de comportamiento).
  billingAnchorDay        Int?

  // Fase 5: flags de avisos ya enviados (mismo patrón que capacityWarningSentAt/mpFirstFailureAt).
  mpWelcomeSentAt         DateTime? // "tu plan quedó activo" tras el primer cobro confirmado
  planExpiredNoticeSentAt DateTime? // "tu plan volvió a modo gratuito"; se limpia al reactivarse

  // ── Guía de inicio (checklist de onboarding para el dueño) ──
  // null = todavía no la abrió (dispara el aviso en el sidebar). Cafés existentes al momento de
  // agregar esto se backfillean a la fecha del backfill para no mostrarles un aviso sorpresa.
  onboardingSeenAt       DateTime?
  onboardingSkippedSteps String?   // JSON array de keys de pasos marcados "no aplica" por el dueño

  // ── Emails de reactivación (dos triggers independientes) ──────────────────
  // Ambos apagados por default (@default(false)): ningún café existente empieza a mandar nada solo
  // por agregar estas columnas. mensaje null = usa el default de marca definido en lib/reengagement.ts
  // (se resuelve al leer, no se congela en el schema, así una mejora futura del copy default alcanza
  // a los cafés que nunca lo personalizaron).
  reengagementInactiveEnabled  Boolean   @default(false)
  reengagementInactiveDays     Int       @default(15) // días desde el último sello
  reengagementInactiveMessage  String?
  reengagementCompletedEnabled Boolean   @default(false)
  reengagementCompletedDays    Int       @default(3)  // días desde que la tarjeta quedó completa sin canjear
  reengagementCompletedMessage String?

  // Referidos entre cafeterías: si esta cafetería llegó recomendada por otra, la que la mandó
  // gana un mes gratis cuando esta empieza a pagar (ver el pase 12 del cron). Sin tope.
  referredByCafeId String?
  referredByCafe   Cafe?  @relation("CafeReferrals", fields: [referredByCafeId], references: [id])
  referredCafes    Cafe[] @relation("CafeReferrals")
  referralRewardGrantedAt DateTime? // ya se le acreditó el mes a quien la refirió (una sola vez)

  owner    Owner    @relation(fields: [ownerId], references: [id])
  ownerId  String

  customers CustomerCafe[]
  rewards   Reward[]
  transactions Transaction[]
  staff     CafeStaff[]
  campaigns Campaign[]
  referrals Referral[]
  apiKeys   ApiKey[]
  broadcasts Broadcast[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Owner {
  id                 String   @id @default(cuid())
  email              String   @unique
  password           String
  name               String
  mustChangePassword Boolean  @default(false)
  cafes              Cafe[]
  createdAt          DateTime @default(now())
}

model CafeStaff {
  id                 String   @id @default(cuid())
  email              String   @unique
  password           String
  name               String
  role               String   @default("cashier")
  cafe               Cafe     @relation(fields: [cafeId], references: [id])
  cafeId             String
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())

  @@index([cafeId])
}

model Customer {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  phone          String?
  birthdate      DateTime?
  favoriteDrink  String?
  createdAt      DateTime  @default(now())

  cafes        CustomerCafe[]
  transactions Transaction[]
  broadcastRecipients BroadcastRecipient[]
}

model CustomerOtp {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model CustomerCafe {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String
  cafe       Cafe     @relation(fields: [cafeId], references: [id])
  cafeId     String

  stamps     Int      @default(0)
  totalStamps Int     @default(0) // lifetime stamps (never resets)
  points     Float    @default(0)
  totalSpent Float    @default(0)

  stampsExpireAt     DateTime? // cuándo vencen los sellos activos (se renueva con cada sello nuevo)
  stampsExpiryWarned Boolean  @default(false) // ya se avisó del vencimiento próximo (evita spam)

  // ── Reactivación: tracking para los 2 triggers de lib/purchase.ts + cron ──
  // lastStampAt: se pisa en cada stamp_add. cardCompletedAt: se setea al cruzar stampsRequired por
  // primera vez, se limpia al canjear. Los *SentAt son flags "ya avisado en esta racha" (mismo
  // patrón que stampsExpiryWarned) — se limpian cuando la racha termina (nuevo sello / canje) para
  // poder volver a avisar en la próxima racha de inactividad o de tarjeta completa.
  lastStampAt                 DateTime?
  cardCompletedAt              DateTime?
  reengagementInactiveSentAt   DateTime?
  reengagementCompletedSentAt  DateTime?

  // Puntos de regalo (campañas bonus_points). Bucket único con un solo vencimiento,
  // mismo patrón que los sellos: cada regalo nuevo renueva el deadline de todo el bucket.
  bonusPoints   Float     @default(0)
  bonusExpireAt DateTime?

  referralCode String? @unique // código para invitar amigos a este café (se genera al pedirlo)

  // Difusión (mailing masivo del dueño). Por café, no global: un cliente puede cortar la difusión de
  // un café y seguir recibiendo la de otro. No afecta emails transaccionales (OTP, vencimiento de
  // sellos, reactivación) — esos no son marketing.
  marketingOptOut Boolean @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, cafeId])
  @@index([cafeId])
}

model Transaction {
  id          String   @id @default(cuid())
  cafe        Cafe     @relation(fields: [cafeId], references: [id])
  cafeId      String
  customer    Customer @relation(fields: [customerId], references: [id])
  customerId  String

  type        String   // "stamp_add" | "stamp_redeem" | "points_add" | "points_redeem" | "referral_reward"
  amount      Float?   // purchase amount (for points)
  stamps      Int?     // stamps added/used
  points      Float?   // points added/used
  note        String?  // e.g. reward name redeemed
  externalId  String?  // idempotencia de la API v1: id del ticket/venta en el sistema externo

  createdAt   DateTime @default(now())

  @@unique([cafeId, externalId]) // un mismo ticket externo no puede acreditarse dos veces
  @@index([cafeId])
  @@index([cafeId, createdAt])
  @@index([customerId])
}

model Reward {
  id          String   @id @default(cuid())
  cafe        Cafe     @relation(fields: [cafeId], references: [id])
  cafeId      String
  name        String
  description String?
  pointsCost  Float
  active      Boolean  @default(true)
  emoji       String?  @default("🎁")
  createdAt   DateTime @default(now())

  @@index([cafeId])
}

// Campañas del dueño: multiplicadores de puntos/sellos, puntos de regalo por compra, o bono de
// bienvenida por registrarse — todo con vigencia por fechas. Los tres primeros tipos se aplican
// en el momento de la compra (lib/purchase.ts); signup_bonus se aplica al vincularse al café
// por primera vez (lib/signup.ts), sea por la loyalty page, caja o API.
model Campaign {
  id              String   @id @default(cuid())
  cafe            Cafe     @relation(fields: [cafeId], references: [id])
  cafeId          String
  name            String
  type            String   // "points_multiplier" | "stamp_multiplier" | "bonus_points" | "signup_bonus"
  multiplier      Float?   // para *_multiplier (ej: 2 = doble)
  bonusPoints     Float?   // para bonus_points/signup_bonus: pts de regalo
  bonusStamps     Int?     // para signup_bonus: sellos de regalo al registrarse
  bonusExpiryDays Int      @default(30) // vigencia de los pts de regalo desde que se otorgan
  startsAt        DateTime
  endsAt          DateTime
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([cafeId, endsAt])
}

// Referidos: se crea "pending" cuando el referido se suma con un código, y pasa a
// "converted" (acreditando el premio al referente UNA sola vez) en su 1ª compra real.
model Referral {
  id                 String    @id @default(cuid())
  cafe               Cafe      @relation(fields: [cafeId], references: [id])
  cafeId             String
  referrerCustomerId String
  referredCustomerId String
  status             String    @default("pending") // "pending" | "converted"
  rewardGranted      Boolean   @default(false)
  createdAt          DateTime  @default(now())
  convertedAt        DateTime?

  @@unique([cafeId, referredCustomerId]) // un cliente solo puede ser referido una vez por café
  @@index([cafeId, referrerCustomerId])
}

// Mailing de difusión del dueño a sus clientes registrados. Se materializa un BroadcastRecipient
// por cliente NO opt-out al momento de componer (no en el momento de enviar) — así el cron solo
// tiene que drenar "pendientes" en lotes, sin re-evaluar opt-outs a mitad de un envío en curso.
model Broadcast {
  id              String    @id @default(cuid())
  cafe            Cafe      @relation(fields: [cafeId], references: [id])
  cafeId          String
  subject         String
  message         String    // texto plano; se escapa y se inserta en la plantilla de marca al enviar
  status          String    @default("pending") // "pending" | "sending" | "done"
  totalRecipients Int       @default(0)
  sentCount       Int       @default(0)
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  recipients BroadcastRecipient[]

  @@index([cafeId])
  @@index([status])
}

model BroadcastRecipient {
  id          String     @id @default(cuid())
  broadcast   Broadcast  @relation(fields: [broadcastId], references: [id])
  broadcastId String
  customer    Customer   @relation(fields: [customerId], references: [id])
  customerId  String
  sentAt      DateTime? // null = pendiente; si el envío falla queda null y el cron reintenta solo

  @@unique([broadcastId, customerId])
  @@index([broadcastId, sentAt])
}

// Claves de la API pública v1 (integraciones ERP/POS por café).
// Nunca se guarda la clave: solo su hash SHA-256 y un prefijo visible para identificarla.
model ApiKey {
  id         String    @id @default(cuid())
  cafe       Cafe      @relation(fields: [cafeId], references: [id])
  cafeId     String
  name       String    // "Restolia", "Zapier"…
  prefix     String    // ej: "sipo_live_ab12…" (identificación visual)
  keyHash    String    @unique // sha256 hex de la clave completa
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([cafeId])
}

// Config global de la plataforma (fila única, id="singleton").
// La edita el superadmin; la landing/demo lee de acá sus datos de contacto.
model PlatformConfig {
  id             String   @id @default("singleton")
  contactEmail   String?
  whatsappNumber String?  // solo dígitos, formato internacional (ej: 549341...)
  whatsappUrl    String?  // opcional, si se prefiere un link armado
  instagramUrl   String?  // IG de la plataforma Sipo
  xUrl           String?  // X/Twitter de la plataforma Sipo
  graceDays      Int      @default(7)  // días de gracia tras el vencimiento antes de cortar
  capacityWarningPercent Int @default(80) // % del tope de clientes que dispara el aviso proactivo
  priceChangeNoticeDays  Int @default(14) // días de aviso previo antes de aplicar un precio nuevo
  updatedAt      DateTime @updatedAt
}

// Override editable de precio/tope por tier. Los valores por defecto viven en lib/plans.ts
// (DEFAULT_PLAN_TIERS); esta tabla solo guarda lo que el superadmin cambió desde el panel.
// Un tier sin fila acá usa el default. Ver lib/planTiers.ts para la resolución.
model PlanTierConfig {
  tier          String   @id // "free" | "economico" | "medio" | "grande"
  customerLimit Int
  price         Int
  updatedAt     DateTime @updatedAt
}

// Solicitudes de alta self-service (leads). No están ligadas a un Cafe todavía.
model CafeSignupRequest {
  id         String   @id @default(cuid())
  cafeName   String
  ownerName  String
  email      String
  phone      String?
  city       String?
  instagram  String?
  message    String?
  referredBy String?  // texto libre: qué cafetería dice que le recomendó Sipo
  status     String   @default("pending") // "pending" | "approved" | "rejected"
  createdAt  DateTime @default(now())

  @@index([status])
}
